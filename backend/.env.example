# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Port the API listens on
PORT=4000

# REQUIRED — strong random value used to sign JWTs and file tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start without it. Rotating it logs out all users.
JWT_SECRET=

# Public URL of the frontend (used in password-reset emails)
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed by CORS (defaults to localhost dev origins)
# ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# Optional SMTP — set these to send real password-reset/backup emails (Gmail: use an App Password)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=your-app-password
