# PostHog product analytics.
# Leave VITE_PUBLIC_POSTHOG_KEY unset to disable analytics entirely — the app
# runs normally and no events are sent.
# Find the key at PostHog → Settings → Project → Project API Key ("phc_...").
VITE_PUBLIC_POSTHOG_KEY=
# US cloud (default) or https://eu.i.posthog.com for EU projects.
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Backend origin for split hosting (e.g. https://api.example.com).
# Unset = same-origin/relative, which is what the dev proxy expects.
VITE_API_URL=
